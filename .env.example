# ==============================================================================
# TeebTech Development Environment Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=3000

# Public Client Configuration (Safe for browser/WASM)
APP_ENV=development
APP_NAME=TeebTech
API_BASE_URL=/api

# Server Secrets (Server-only, NEVER expose to client WASM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teebtech_dev
JWT_SECRET=dev_jwt_secret_change_in_production_32_bytes_min
